# Long cache for static files. The worker sets the same Cache-Control on the response.
/img/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/feed.xml
  X-Robots-Tag: noindex

/nl/feed.xml
  X-Robots-Tag: noindex

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable
